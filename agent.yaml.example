device_id: "laptop-turn-01"
server_url: "https://monitor.example.com/api/heartbeat"
api_key: "REDACTED"
interval_seconds: 15
jitter_seconds: 3
buffer_path: "./agent-buffer.db"
buffer_max_size_mb: 50
log_level: "info"

collectors:
  cpu: true
  memory: true
  disk: true
  network: true
  battery: true
  temperature: true
  fan: false
  disk_smart: true
  gpu: true
  energy: false
  top_process: true
  turn_process: true
