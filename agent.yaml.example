device_id: "laptop-turn-01"
server_url: "https://monitor.example.com/api/heartbeat"
api_key: "REDACTED"
interval_seconds: 15
jitter_seconds: 3
buffer_path: "./agent-buffer.db"
buffer_max_size_mb: 50
log_level: "info"

# Only registered collectors may be enabled. As each collector lands in
# Phase 2+, flip it to true.
collectors:
  self: true
  cpu: true
  memory: true
  disk: false
  network: false
  battery: false
  temperature: false
  fan: false
  disk_smart: false
  gpu: false
  energy: false
  top_process: false
  turn_process: false
